# apps/web
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: use the PEM key for networkless Clerk request verification.
CLERK_JWT_KEY=
# Set this to the deployed web origin in Vercel, for example https://app.example.com.
NEXT_PUBLIC_APP_URL=
# CLI login opens this dashboard URL in a browser.
OPENCMS_DASHBOARD_URL=
# GitHub repository containing the versioned canonical Next.js template.
OPENCMS_TEMPLATE_REPO=https://github.com/maker-or/nextjs-template.git
# Optional: when set, `opencms deploy` also runs `vercel --prod`.
VERCEL_TOKEN=

# packages/db
DATABASE_URL=

# apps/cli
# Set this to the deployed OpenCMS API origin for remote CLI use.
OPENCMS_API_URL=
# A Clerk session token for local CLI/API testing.
OPENCMS_CLERK_TOKEN=
