# apps/web
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: use the PEM key for networkless Clerk request verification.
CLERK_JWT_KEY=
# Set this to the deployed web origin in Vercel, for example https://app.example.com.
NEXT_PUBLIC_APP_URL=
# Optional comma-separated LAN hostnames/IPs allowed to request Next.js dev resources.
NEXT_ALLOWED_DEV_ORIGINS=
# Preferred: one OpenCMS control-plane origin for CLI API calls and browser login.
OPENCMS_URL=
# Optional legacy/separate overrides. OPENCMS_URL takes precedence when set.
OPENCMS_DASHBOARD_URL=
# GitHub repository containing the versioned canonical Next.js template.
OPENCMS_TEMPLATE_REPO=https://github.com/maker-or/nextjs-template.git
# Optional: when set, `opencms deploy` also runs `vercel --prod`.
VERCEL_TOKEN=

# packages/db
DATABASE_URL=

# apps/cli
# Optional legacy override for the OpenCMS API origin. Prefer OPENCMS_URL above.
OPENCMS_API_URL=
# A Clerk session token for local CLI/API testing.
OPENCMS_CLERK_TOKEN=
